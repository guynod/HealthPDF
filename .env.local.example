# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional. Defaults to 15 MB.
HEALTHPDF_MAX_UPLOAD_MB=15

# Optional privacy tradeoff. Leave false unless you want provider names/addresses
# sent to OpenStreetMap Nominatim for classification help.
HEALTHPDF_ENABLE_PROVIDER_LOOKUP=false
